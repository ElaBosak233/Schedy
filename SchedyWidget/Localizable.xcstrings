    "widget.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a timetable to see the date and next two classes using its assigned time preset."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要显示的课表，将使用该课表绑定的时间段展示日期与接下来两节课。"
          }
        }
      }
    },
    "widget.empty.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No classes today. Enjoy your break!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天没课哦，好好休息吧"

    "widget.configuration.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a timetable for this widget. Its assigned time preset will be used."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要在小组件中显示的课表，将使用该课表绑定的时间段"
          }
        }
      }
    },
    "widget.configuration.follow_app": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow App Selection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随 App 当前选中"
          }
        }
      }
    },

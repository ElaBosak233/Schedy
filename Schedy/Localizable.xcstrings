      "comment": "CSV template. Keep the Chinese header names and field order unchanged; use all/odd/even and numeric weekdays in English.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "课程名,教师,地点,学分,周次,单双周,星期,起始节,结束节\nCalculus,Dr. Smith,A101,4.0,1-16,all,1,1,2\nEnglish,Dr. Lee,B201,2.0,1-16,all,3,3,4\nProgramming,Dr. Wang,C301,3.0,1-8,odd,5,5,"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "课程名,教师,地点,学分,周次,单双周,星期,起始节,结束节\n高等数学,张老师,教学楼A101,4.0,1-16,全部,1,1,2\n大学英语,李老师,教学楼B201,2.0,1-16,全部,3,3,4\n程序设计,王老师,实验楼C301,3.0,1-8,单周,5,5,"
          }
        }
      }
    },

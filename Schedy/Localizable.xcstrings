    },
    "sync.enable.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iCloud data will sync to this device automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，iCloud 数据将自动同步到本设备。"
          }
        }
      }
    },
    "sync.enable.merge_description": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "You have %lld local timetable.\n\nMerge: Keep local data and merge it with iCloud.\nReplace: Delete local data and use only the data from iCloud."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "You have %lld local timetables.\n\nMerge: Keep local data and merge it with iCloud.\nReplace: Delete local data and use only the data from iCloud."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地有 %lld 张课程表。\n\n合并：保留本地数据，并与 iCloud 云端数据合并。\n云端覆盖：删除本地数据，完全使用 iCloud 云端数据。"
          }
        }
      }
    },
    "sync.enable.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn On iCloud Sync"
          }
        },

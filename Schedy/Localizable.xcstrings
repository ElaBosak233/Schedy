    "sync.disable.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only local data will be used. Your data in iCloud will be kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后将仅使用本地数据，iCloud 中的数据不受影响。"

        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将清除所有课程表与时间段数据，并重新创建默认课程表，此操作不可撤销。"
          }
        }
      }
    },
    "sync.reset.description": {
      "localizations": {
